{
  "schema_version": 1,
  "updated_at": "2026-03-24",
  "source": {
    "owner": "human-agent-cowork-workflow/scripts",
    "file": "scripts/tool_mapping_template.json",
    "notes": [
      "This is the canonical capability-level mapping template.",
      "Platform built-in tool names are not guaranteed to be stable across versions."
    ]
  },
  "platforms": [
    {
      "id": "github_copilot_vscode",
      "display_name": "GitHub Copilot (VS Code Agent)"
    },
    {
      "id": "cursor_agent",
      "display_name": "Cursor Agent"
    },
    {
      "id": "opencode_agent",
      "display_name": "OpenCode Agent"
    }
  ],
  "name_replacements": {
    "cursor_agent": {
      "read_file": "read",
      "grep_search": "grep",
      "file_search": "search",
      "apply_patch": "edit",
      "str_replace": "edit",
      "create_file": "edit",
      "run_in_terminal": "execute",
      "create_and_run_task": "execute",
      "fetch_webpage": "web",
      "vscode_askQuestions": "question",
      "runSubagent": "Task"
