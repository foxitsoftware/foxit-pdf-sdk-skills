  "mcp_policy": {
    "principle": "If the same MCP server is configured across platforms, use MCP tool names as the cross-platform source of truth.",
    "recommendation": [
      "Keep capability IDs stable and platform adapters mutable.",
      "Prefer exact names for OpenCode built-in tools.",
      "Treat GitHub Copilot and Cursor names as candidate sets unless verified in the current runtime."
    ]
  }
